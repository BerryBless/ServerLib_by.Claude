 {
    "enabledPlugins": {
     "harness@harness-marketplace": true,
     "superpowers@claude-plugins-official": true,
     "superpowers@superpowers-marketplace": false
   },
   "env": {
     "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
   },
   "permissions": {
     "deny": [
       "WebSearch",
       "WebFetch",
       "NotebookEdit"
     ]
   },
    "hooks": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "shell": "powershell",
              "command": "pwsh -NonInteractive -File \"E:\\project\\ClaudeCodeStudy\\scripts\\auto-commit.ps1\"",
              "asyncRewake": true,
              "timeout": 60,
              "statusMessage": "변경사항 자동 커밋 중..."
            }
          ]
        }
      ]
    }
  }