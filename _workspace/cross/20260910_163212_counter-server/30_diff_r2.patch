+        {
+            var options = new CounterScenarioOptions
+            {
+                Host = "127.0.0.1",
+                Port = port,
+                ConnectionCount = Connections,
+                IncrementsPerConnection = OpsEachWay,
+                DecrementsPerConnection = OpsEachWay,
+                Timeout = TimeSpan.FromMilliseconds(UnresponsiveTimeoutMs),
+            };
