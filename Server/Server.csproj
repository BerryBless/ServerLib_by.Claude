<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ServerLib\ServerLib.csproj" />
        <ProjectReference Include="..\AppConfig\AppConfig.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.5" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.5" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.5" />
        <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.5" />
        <!-- Windows 전용 per-core CPU 카운터: PerformanceCounter는 .NET Core에서 별도 패키지 필요 -->
        <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
        <!-- MySqlConnector: 비동기 우선 ADO.NET MySQL 드라이버. MySqlConnection per-query 패턴으로 ADO.NET 풀 활용 -->
        <PackageReference Include="MySqlConnector" Version="2.4.0" />
        <!-- StackExchange.Redis: ConnectionMultiplexer 기반 Redis 클라이언트. 소수 커넥션에 모든 명령 멀티플렉싱 -->
        <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Auth\schema.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- ServerLib.Tests가 Server.Auth.* 내부 클래스를 단위 테스트할 수 있도록 허용 -->
    <ItemGroup>
        <InternalsVisibleTo Include="ServerLib.Tests" />
    </ItemGroup>

</Project>
